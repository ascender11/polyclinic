{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": "//",
  "javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } },
  "linter": { "rules": { "style": { "useImportType": "off" } } },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@prisma/**"],
              ":BLANK_LINE:",
              ["@prisma/**"],
              ":BLANK_LINE:",
              ["@/**"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  }
}
