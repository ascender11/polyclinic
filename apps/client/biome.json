{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": "//",
  "html": { "formatter": { "enabled": true } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:"],
              ":BLANK_LINE:",
              ["@/app/**", "@/pages/**", "@/widgets/**", "@/features/**", "@/entities/**"],
              ":BLANK_LINE:",
              ["@/shared/**", "@/shared/ui/**", "@/shared/lib/**", "@/shared/api/**"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  }
}
